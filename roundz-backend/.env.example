NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://roundz:roundz@localhost:5432/roundz?schema=public
MONGO_URL=mongodb://roundz:roundz@localhost:27017/roundz
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_OTP_RATE_LIMIT_MAX=3
AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_OTP_TTL_SECONDS=300
USER_PROFILE_IMAGE_BUCKET=roundz-user-profile-images
USER_CACHE_TTL_SECONDS=300
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
RIDER_SERVICE_URL=http://localhost:3003
TRIP_SERVICE_URL=http://localhost:3004
WALLET_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
LOCATION_SERVICE_URL=http://localhost:3007
ADMIN_SERVICE_URL=http://localhost:3008
GATEWAY_REQUEST_TIMEOUT_MS=15000
GATEWAY_BODY_LIMIT_BYTES=10485760
GATEWAY_HEALTH_TIMEOUT_MS=3000
GATEWAY_GET_RETRY_ATTEMPTS=2
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_OPEN_MS=30000
GATEWAY_RATE_LIMIT_IP_MAX=1200
GATEWAY_RATE_LIMIT_USER_MAX=3000
GATEWAY_RATE_LIMIT_ENDPOINT_MAX=600
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
CLOUD_PROVIDER=aws
STORAGE_PROVIDER=s3
PAYMENT_PROVIDER=razorpay
PUSH_PROVIDER=fcm
ENABLE_EXTERNAL_CONNECTIONS=false
