generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum OtpPurpose {
  LOGIN
  REGISTER
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum RiderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RiderOnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum RiderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiderOnlineStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum VehicleType {
  BIKE
  AUTO
  CAR
  SUV
  VAN
  TRUCK
}

enum RiderDocumentType {
  DRIVING_LICENSE
  VEHICLE_RC
  INSURANCE
  PERMIT
  PROFILE_PHOTO
  IDENTITY_PROOF
  ADDRESS_PROOF
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String      @id @default(uuid())
  email         String?     @unique
  phone         String?     @unique
  passwordHash  String?
  fullName      String
  role          UserRole    @default(CUSTOMER)
  status        UserStatus  @default(PENDING_VERIFICATION)
  emailVerified Boolean     @default(false)
  phoneVerified Boolean     @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  loginAttempts LoginAttempt[]
  sessions      UserSession[]
  profile       UserProfile?
  addresses     Address[]
  favorites     FavoriteLocation[]
  settings      UserSettings?
  rider         Rider?

  @@index([role, status])
  @@index([createdAt])
}

model UserProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  firstName             String
  lastName              String
  gender                Gender?
  profileImageUrl       String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  preferredLanguage     String   @default("en")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([preferredLanguage])
}

model Address {
  id           String       @id @default(uuid())
  userId       String
  label        AddressLabel
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String
  latitude     Float
  longitude    Float
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([userId, createdAt])
  @@index([userId, city])
}

model FavoriteLocation {
  id        String   @id @default(uuid())
  userId    String
  name      String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, address])
  @@index([userId, createdAt])
}

model UserSettings {
  id                            String   @id @default(uuid())
  userId                        String   @unique
  pushNotificationsEnabled      Boolean  @default(true)
  marketingNotificationsEnabled Boolean  @default(false)
  emailNotificationsEnabled     Boolean  @default(true)
  darkModeEnabled               Boolean  @default(false)
  language                      String   @default("en")
  timezone                      String   @default("UTC")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([language])
  @@index([timezone])
}

model Rider {
  id               String                @id @default(uuid())
  userId           String                @unique
  riderCode        String                @unique
  status           RiderStatus           @default(ACTIVE)
  onboardingStatus RiderOnboardingStatus @default(PENDING)
  approvalStatus   RiderApprovalStatus   @default(PENDING)
  onlineStatus     RiderOnlineStatus     @default(OFFLINE)
  profilePhoto     String?
  rating           Float                 @default(0)
  totalTrips       Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]
  documents  RiderDocument[]
  preference RiderPreference?

  @@index([approvalStatus, onboardingStatus])
  @@index([onlineStatus])
  @@index([status])
  @@index([createdAt])
}

model Vehicle {
  id                 String      @id @default(uuid())
  riderId            String
  vehicleType        VehicleType
  brand              String
  model              String
  color              String
  registrationNumber String      @unique
  registrationState  String
  manufacturingYear  Int
  insuranceExpiry    DateTime?
  permitExpiry       DateTime?
  isPrimary          Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, isPrimary])
  @@index([riderId, createdAt])
}

model RiderDocument {
  id                 String                     @id @default(uuid())
  riderId            String
  documentType       RiderDocumentType
  fileUrl            String
  verificationStatus DocumentVerificationStatus @default(PENDING)
  rejectionReason    String?
  uploadedAt         DateTime                   @default(now())
  verifiedAt         DateTime?

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, documentType])
  @@index([riderId, verificationStatus])
}

model RiderPreference {
  id               String   @id @default(uuid())
  riderId          String   @unique
  preferredLanguage String  @default("en")
  autoAcceptTrips  Boolean  @default(false)
  receivePromotions Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  sessionId String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model OtpCode {
  id           String     @id @default(uuid())
  userId       String?
  destination  String
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destination, purpose, consumedAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id            String   @id @default(uuid())
  identifier    String
  userId        String?
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model ServiceOutboxEvent {
  id          String   @id @default(uuid())
  topic       String
  key         String?
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([topic, createdAt])
}
