generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceOutboxEvent {
  id          String   @id @default(uuid())
  topic       String
  key         String?
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([topic, createdAt])
}
